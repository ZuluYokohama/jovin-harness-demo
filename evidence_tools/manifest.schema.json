{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "jovin-demo.evidence.v1"
    },
    "classification": {
      "const": "synthetic-public-demo"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "full_name",
        "id"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "pull_request": {
      "type": "integer",
      "minimum": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "tests": {
            "$ref": "#/$defs/path"
          }
        },
        "required": [
          "path",
          "tests"
        ]
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ]
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "$ref": "#/$defs/path"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "head_id": {
          "$ref": "#/$defs/receiptId"
        },
        "head_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "index",
        "count",
        "head_id",
        "head_sha256"
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/stage"
        },
        "bad": {
          "$ref": "#/$defs/stage"
        },
        "fixed": {
          "$ref": "#/$defs/stage"
        }
      },
      "required": [
        "baseline",
        "bad",
        "fixed"
      ]
    }
  },
  "required": [
    "format",
    "classification",
    "repository",
    "branch",
    "pull_request",
    "modules",
    "policy",
    "artifacts",
    "chain",
    "stages"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic public demo evidence manifest",
  "description": "Shape only. verify_evidence.py additionally checks bytes, complete chain, bindings and outcomes.",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "gate_receipt_id": {
          "$ref": "#/$defs/receiptId"
        },
        "gate_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "check_url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        }
      },
      "required": [
        "commit",
        "source",
        "gate_receipt_id",
        "gate_receipt_sha256"
      ]
    }
  }
}
